# ==============================================================================
# FOH Table Management System - Backend Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL with psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/foh_management

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# SQLite fallback for quick local testing without PostgreSQL:
# DATABASE_URL=sqlite:///./foh.db

# Authentication / Security
JWT_SECRET=change-me-use-a-long-random-string-in-production
JWT_EXPIRE_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo User Passwords
OWNER_PASSWORD=Owner@1234
MANAGER_PASSWORD=Manager@1234
HOST_PASSWORD=Host@1234
CASHIER_PASSWORD=Cashier@1234
WAITER_PASSWORD=Waiter@1234
CHEF_PASSWORD=Chef@1234
COOK_PASSWORD=Cook@1234

# Computer Vision & Camera Pipeline
CAMERA_ENABLED=true
CAMERA_SCAN_INTERVAL_SECONDS=10
CV_MODEL_NAME=yolo11n.pt
CV_CONFIDENCE_THRESHOLD=0.35
CV_PROCESS_FPS=10
CV_MISMATCH_ALERT_ENABLED=true
